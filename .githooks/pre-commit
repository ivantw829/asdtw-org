#!/usr/bin/env bash
# 提交前：禁止直接在 main 提交 → 自動更新成員數、文章列表、訂閱源、文章分享圖與 sitemap → 網站品質與無障礙檢查
branch=$(git symbolic-ref --short HEAD 2>/dev/null)
if [ "$branch" = "main" ] && [ -z "$ALLOW_MAIN_COMMIT" ]; then
  echo "✗ 請不要直接在 main 上提交。先開分支：git switch -c content/<名稱>（或用 authoring/ship.sh）" >&2
  echo "  （緊急情況可用 ALLOW_MAIN_COMMIT=1 git commit …）" >&2
  exit 1
fi
# 成員數：本機向 Discord 取得並寫進 HTML（訪客端不連外）；連不上時只警告、不擋提交
python3 authoring/build-members.py | while read -r f; do git add "$f"; done
# 共用區塊：只在片段檔有變更時才同步到各頁；否則不自動寫入，避免蓋掉直接改在頁面裡的內容（交給 check.py 報錯）
if [ -n "$(git diff --cached --name-only -- authoring/partials)" ]; then
  python3 authoring/build-shared.py | while read -r f; do git add "$f"; done
fi
# 文章產物：列表／上下篇、訂閱源；分享圖需要本機 Chrome（沒有時 check.py 會指出哪張過期）
python3 authoring/build-lists.py | while read -r f; do git add "$f"; done
python3 authoring/build-feed.py >/dev/null && git add feed.xml
if [ -n "$(git diff --cached --name-only -- data/articles.json authoring/og/article-card.html)" ]; then
  # 用 -A 讓已刪除文章的分享圖也被 stage；沒有任何文章時資料夾不存在，就只 stage manifest
  python3 authoring/build-og.py --articles && git add -A authoring/og/manifest.json $( [ -d assets/img/og ] || git ls-files --error-unmatch assets/img/og >/dev/null 2>&1 && echo assets/img/og )
fi
python3 authoring/build-sitemap.py >/dev/null && git add sitemap.xml
python3 authoring/check.py
